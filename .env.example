# Diamond Hands Protocol — env template
# Copy to .env and fill in. Never commit .env.

# Deployer private key (testnet burner for now — mainnet burner after audit)
PRIVATE_KEY=0x

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Sourcify / Basescan verification
BASESCAN_API_KEY=
SOURCIFY_REPO_URL=https://repo.sourcify.dev/contracts

# Treasury / Fee collector recipient on mainnet — CryptoSI DAO multisig (Base)
# Verify before deploying — keyless/empty addresses will lock fees permanently.
DAO_TREASURY_BASE=